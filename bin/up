#!/usr/bin/env bash

cp example.env .env
# Nisshi checks at startup that its S3 bucket exists, so create the bucket first.
docker compose --progress plain up --no-color --quiet-pull --detach --wait minio
mc ready local
mc alias set local http://localhost:9000 minioadmin minioadmin
mc mb local/nisshi
docker compose --progress plain up --no-color --quiet-pull --detach --remove-orphans
uv sync --all-groups
